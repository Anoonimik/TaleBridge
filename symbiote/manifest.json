{
  "manifestVersion": 1,
  "name": "TaleBridge",
  "summary": "Obsidian Companion & Bridge for TaleSpire",
  "descriptionFilePath": "/README.md",
  "version": "0.7.0",
  "license": "GPL-3.0-only",
  "about": {
    "website": "",
    "authors": [
      "GM"
    ]
  },
  "kind": "webView",
  "entryPoint": "/dist/index.html",
  "api": {
    "version": "0.1",
    "subscriptions": {
      "dice": {
        "onRollResults": "handleRollResults"
      },
      "symbiote": {
        "onVisibilityEvent": "handleVisibilityEvent",
        "onStateChangeEvent": "onStateChangeEvent"
      },
      "creatures": {
        "onCreatureStateChange": "handleCreatureStateChange"
      }
    }
  },
  "controls": {
    "reload": true
  },
  "environment": {
    "capabilities": [
      "runInBackground"
    ],
    "webViewBackgroundColor": "#141416"
  }
}
